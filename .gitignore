# Зависимости
/node_modules
/vendor
/backend/vendor
/frontend/node_modules

# Сборка
/frontend/dist
/backend/public/build
/backend/public/hot

# Локальная база и логи
/backend/database/*.sqlite
/backend/database/*.sqlite-journal
/backend/storage/*.key
/backend/storage/logs/*.log
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/app/apex-backup/

# Окружение
.env
.env.*
!.env.example
/backend/.env
/frontend/.env
/frontend/.env.*

# Временные артефакты правок
*.apex-bak
*.apex-bak.*
.apex-backup/

# Редакторы и ОС
.idea/
.vscode/
.DS_Store
Thumbs.db
