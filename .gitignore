# ============================================================
#  Minecraft: сервер, плагины и сборки
# ============================================================
#  Здесь всё, что относится к игровому серверу, а не к сайту.
#  Папка plugins/ — это живой сервер: jar-ы плагинов, их конфиги,
#  миры и логи. Весит под 150 МБ, в репозитории ей не место.

# Живой сервер: плагины, конфиги, миры
/plugins/
/server/
/minecraft-server/
/run/

# Исходники наших плагинов
/minecraft-plugin/
/minecraft-rod-plugin/
/minecraft-tier-plugin/
/minecraft-tier-plugin-18/
/minecraft-*/

# Сборка Maven и Gradle
/target/
**/target/
/build/
**/build/
.gradle/
*.jar
*.class
*.pom

